<?xml version="1.0"?>
<templates>
<t t-name="ai_debug.ExportButton">
    <button class="icon-btn" t-on-click="this.onClick"
            title="Export this thread as JSON" style="transform: none;">
        <i class="fa fa-download" aria-hidden="true" style="transform: none;"/>
    </button>
</t>
<t t-name="ai_debug.ImportButton">
    <button class="icon-btn" t-on-click="this.onClick"
            title="Import a transcript JSON" style="transform: none;">
        <i class="fa fa-upload" aria-hidden="true" style="transform: none;"/>
    </button>
</t>
</templates>
