<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_debug.App">
    <div class="ai-debug-app">
        <!-- Header bar -->
        <header class="ai-debug-header">
            <div class="ai-debug-header-title">AI Debugger</div>
            <div class="ai-debug-header-status">
                <span t-attf-class="ai-debug-status-dot {{statusColor}}"/>
                <span class="ai-debug-status-label" t-esc="statusLabel"/>
                <span t-if="state.ephemeralMode"
                      class="ai-ephemeral-indicator"
                      title="IndexedDB unavailable — traces won't persist across refreshes">
                    Ephemeral
                </span>
            </div>
        </header>

        <!-- Main content area -->
        <div class="ai-debug-main">

            <!-- Sidebar -->
            <aside class="ai-debug-sidebar" t-attf-style="width: {{state.sidebarWidth}}px; min-width: {{state.sidebarWidth}}px;">

                <!-- Traces header bar with select-all + action buttons — stays pinned -->
                <div class="ai-tree-header">
                    <div class="ai-tree-header-left">
                        <input type="checkbox"
                               class="ai-tree-select-all"
                               t-ref="selectAll"
                               t-att-checked="allChecked"
                               t-on-change.stop="toggleSelectAll"/>
                        <span>Traces</span>
                    </div>
                    <div class="ai-tree-header-actions">
                        <button class="ai-tree-action-btn"
                                t-att-disabled="state.checkedTraceIds.size === 0 or undefined"
                                t-on-click="exportSelected"
                                title="Export selected">&#x2913;</button>
                        <button class="ai-tree-action-btn"
                                t-on-click="openImportPicker"
                                title="Import traces">&#x2912;</button>
                        <button class="ai-tree-action-btn"
                                t-att-disabled="state.checkedTraceIds.size === 0 or undefined"
                                t-on-click="deleteCheckedTraces"
                                title="Delete selected">&#x1F5D1;</button>
                    </div>
                </div>

                <!-- Scrollable tree content area — t-ref here so scrollIntoView targets the right container -->
                <div class="ai-tree-content" t-ref="sidebar">

                <!-- Empty state — only when no traces -->
                <div t-if="traces.size === 0" class="ai-debug-sidebar-empty">
                    <span class="ai-debug-pulse-dot"/>
                    <span>No traces yet</span>
                </div>

                <!-- Tree entries — Loop > Iteration > Tool Call -->
                <t t-foreach="[...traces.keys()].reverse()" t-as="traceId" t-key="traceId">
                    <t t-set="trace" t-value="traces.get(traceId)"/>

                    <!-- Level 0: Loop entry -->
                    <div class="ai-tree-row level-0"
                         t-att-class="{
                             'selected': state.selectedId === traceId,
                             'ancestor': selectedTraceId === traceId and state.selectedId !== traceId
                         }"
                         t-att-data-node-id="traceId">
                        <input type="checkbox"
                               class="ai-tree-row-check"
                               t-att-checked="state.checkedTraceIds.has(traceId)"
                               t-on-change.stop="() => this.toggleTraceCheck(traceId)"/>
                        <span class="ai-tree-chevron"
                              t-att-class="{'expanded': trace.expanded}"
                              t-on-click.stop="() => this.toggleExpand(traceId, 'trace')">&#x203A;</span>
                        <span class="ai-tree-label"
                              t-on-click="() => this.selectItem(traceId, 'trace')">
                            <t t-if="trace.user_query">
                                <span class="ai-tree-query-title"
                                      t-att-title="trace.user_query"
                                      t-on-click="(ev) => this.showFullQuery(ev, trace.user_query)"
                                      t-esc="trace.user_query"/>
                            </t>
                            <t t-else="">
                                <t t-esc="trace.agent_name or 'Unknown Agent'"/>
                            </t>
                            <span class="ai-tree-meta-line">
                                <t t-esc="trace.agent_name or 'Agent'"/> &#xB7; <t t-esc="trace.model_name or ''"/>
                            </span>
                        </span>
                        <span t-if="trace.hydrated" class="ai-tree-hydrated-badge" title="Loaded from storage">archived</span>
                        <!-- Status indicator -->
                        <span t-if="trace.status === 'running'" class="ai-debug-pulse-dot small"/>
                        <span t-elif="trace.status === 'success'" class="ai-tree-status success">&#x2713;</span>
                        <span t-elif="trace.status === 'error'" class="ai-tree-status error">&#x2717;</span>
                        <span t-elif="trace.status === 'max_iterations'" class="ai-tree-status warn">&#x23F8;</span>
                    </div>

                    <!-- Level 1: Iteration entries (when loop expanded) — latest on top -->
                    <t t-if="trace.expanded">
                        <t t-foreach="[...trace.iterations.keys()].reverse()" t-as="iterationId" t-key="iterationId">
                            <t t-set="iteration" t-value="trace.iterations.get(iterationId)"/>

                            <div class="ai-tree-row level-1"
                                 t-att-class="{
                                     'selected': state.selectedId === iterationId,
                                     'ancestor': selectedIterationId === iterationId and state.selectedId !== iterationId
                                 }"
                                 t-att-data-node-id="iterationId">
                                <span class="ai-tree-chevron"
                                      t-att-class="{'expanded': iteration.expanded}"
                                      t-on-click.stop="() => this.toggleExpand(traceId, iterationId)">&#x203A;</span>
                                <span class="ai-tree-label"
                                      t-on-click="() => this.selectItem(iterationId, 'iteration')">
                                    Iteration <t t-esc="iteration.iteration_index"/>
                                    <t t-set="duration" t-value="this.getIterationDuration(trace, iterationId)"/>
                                    <t t-if="duration">
                                        <span class="ai-tree-label-dim"> &#xB7; <t t-esc="duration"/></span>
                                    </t>
                                    <t t-elif="trace.status === 'running' and iterationId === [...trace.iterations.keys()].pop()">
                                        <span class="ai-tree-label-dim"> &#xB7; <span class="ai-debug-pulse-dot tiny"/></span>
                                    </t>
                                    <t t-if="iteration.has_error"><span class="ai-tree-label-error"> &#xB7; error</span></t>
                                </span>
                            </div>

                            <!-- Level 2: Tool call entries (when iteration expanded) -->
                            <t t-if="iteration.expanded">
                                <t t-foreach="[...iteration.toolCalls.keys()]" t-as="toolCallId" t-key="toolCallId">
                                    <t t-set="tc" t-value="iteration.toolCalls.get(toolCallId)"/>

                                    <div class="ai-tree-row level-2"
                                         t-att-class="{'selected': state.selectedId === toolCallId}"
                                         t-att-data-node-id="toolCallId">
                                        <span class="ai-tree-chevron-placeholder"/>
                                        <span class="ai-tree-label"
                                              t-on-click="() => this.selectItem(toolCallId, 'tool_call')">
                                            <t t-esc="tc.tool_name"/>
                                        </span>
                                        <span t-if="tc.success" class="ai-tree-status success">&#x2714;</span>
                                        <span t-else="" class="ai-tree-status error">&#x2717;</span>
                                    </div>

                                </t>
                            </t>

                        </t>
                    </t>

                </t>

                </div> <!-- end .ai-tree-content -->

            </aside>

            <div class="ai-debug-resize-handle"
                 t-on-pointerdown="onResizeStart"/>

            <!-- Detail panel -->
            <main class="ai-debug-detail">
                <!-- Empty state: no traces at all (SESS-03) -->
                <div t-if="traces.size === 0" class="ai-debug-detail-empty">
                    <span class="ai-debug-pulse-dot large"/>
                    <p>Listening for agentic loops...</p>
                    <p class="ai-debug-detail-hint">
                        Trigger an AI action in Odoo to see live trace data here.
                    </p>
                </div>
                <!-- Loop detail -->
                <LoopDetail t-elif="state.selectedType === 'trace'"
                            t-key="state.selectedId"
                            trace="getSelectedTrace()"/>
                <!-- Iteration detail -->
                <IterationDetail t-elif="state.selectedType === 'iteration'"
                                 t-key="state.selectedId"
                                 iteration="getSelectedIteration()"/>
                <!-- Tool call detail -->
                <ToolCallDetail t-elif="state.selectedType === 'tool_call'"
                                t-key="state.selectedId"
                                toolCall="getSelectedToolCall()"/>
                <!-- Fallback: traces exist but nothing selected (safety net; normally unreachable due to auto-select) -->
                <div t-else="" class="ai-debug-detail-empty">
                    <p>Select a trace, iteration, or tool call to inspect it.</p>
                </div>
            </main>

        </div>
        <MainComponentsContainer/>
        <input type="file"
               accept=".json"
               class="d-none"
               t-ref="fileInput"
               t-on-change="onFileSelected"/>
    </div>
</t>

</templates>
