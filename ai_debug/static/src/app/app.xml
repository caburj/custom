<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_debug.App">
    <div class="ai-debug-app">
        <!-- Header bar -->
        <header class="ai-debug-header">
            <div class="ai-debug-header-title">AI Debugger</div>
            <div class="ai-debug-header-status">
                <span t-attf-class="ai-debug-status-dot {{statusColor}}"/>
                <span class="ai-debug-status-label" t-esc="statusLabel"/>
            </div>
        </header>

        <!-- Main content area -->
        <div class="ai-debug-main">

            <!-- Sidebar -->
            <aside class="ai-debug-sidebar" t-ref="sidebar">

                <!-- Traces header bar with clear button -->
                <div class="ai-tree-header">
                    <span>Traces</span>
                    <button class="ai-tree-clear" t-on-click="clearAll" title="Clear all traces">&#x1F5D1;</button>
                </div>

                <!-- Empty state — only when no traces -->
                <div t-if="traces.size === 0" class="ai-debug-sidebar-empty">
                    <span class="ai-debug-pulse-dot"/>
                    <span>Waiting for traces...</span>
                </div>

                <!-- Tree entries — Loop > Iteration > Tool Call -->
                <t t-foreach="[...traces.keys()]" t-as="traceId" t-key="traceId">
                    <t t-set="trace" t-value="traces.get(traceId)"/>

                    <!-- Level 0: Loop entry -->
                    <div class="ai-tree-row level-0"
                         t-att-class="{
                             'selected': state.selectedId === traceId,
                             'ancestor': selectedTraceId === traceId and state.selectedId !== traceId
                         }"
                         t-att-data-node-id="traceId">
                        <span class="ai-tree-chevron"
                              t-att-class="{'expanded': trace.expanded}"
                              t-on-click.stop="() => this.toggleExpand(traceId, 'trace')">&#x203A;</span>
                        <span class="ai-tree-label"
                              t-on-click="() => this.selectItem(traceId, 'trace')">
                            <t t-esc="trace.agent_name or 'Unknown Agent'"/>
                            <span class="ai-tree-label-dim"> &#xB7; <t t-esc="trace.model_name or ''"/></span>
                        </span>
                        <!-- Status indicator -->
                        <span t-if="trace.status === 'running'" class="ai-debug-pulse-dot small"/>
                        <span t-elif="trace.status === 'success'" class="ai-tree-status success">&#x2713;</span>
                        <span t-elif="trace.status === 'error'" class="ai-tree-status error">&#x2717;</span>
                        <span t-elif="trace.status === 'max_iterations'" class="ai-tree-status warn">&#x23F8;</span>
                    </div>

                    <!-- Level 1: Iteration entries (when loop expanded) — latest on top -->
                    <t t-if="trace.expanded">
                        <t t-foreach="[...trace.iterations.keys()].reverse()" t-as="iterationId" t-key="iterationId">
                            <t t-set="iteration" t-value="trace.iterations.get(iterationId)"/>

                            <div class="ai-tree-row level-1"
                                 t-att-class="{
                                     'selected': state.selectedId === iterationId,
                                     'ancestor': selectedIterationId === iterationId and state.selectedId !== iterationId
                                 }"
                                 t-att-data-node-id="iterationId">
                                <span class="ai-tree-chevron"
                                      t-att-class="{'expanded': iteration.expanded}"
                                      t-on-click.stop="() => this.toggleExpand(traceId, iterationId)">&#x203A;</span>
                                <span class="ai-tree-label"
                                      t-on-click="() => this.selectItem(iterationId, 'iteration')">
                                    Iteration <t t-esc="iteration.iteration_index"/>
                                    <t t-if="iteration.has_error"><span class="ai-tree-label-error"> &#xB7; error</span></t>
                                </span>
                            </div>

                            <!-- Level 2: Tool call entries (when iteration expanded) -->
                            <t t-if="iteration.expanded">
                                <t t-foreach="[...iteration.toolCalls.keys()]" t-as="toolCallId" t-key="toolCallId">
                                    <t t-set="tc" t-value="iteration.toolCalls.get(toolCallId)"/>

                                    <div class="ai-tree-row level-2"
                                         t-att-class="{'selected': state.selectedId === toolCallId}"
                                         t-att-data-node-id="toolCallId">
                                        <span class="ai-tree-chevron-placeholder"/>
                                        <span class="ai-tree-label"
                                              t-on-click="() => this.selectItem(toolCallId, 'tool_call')">
                                            <t t-esc="tc.tool_name"/>
                                        </span>
                                        <span t-if="tc.success" class="ai-tree-status success">&#x2714;</span>
                                        <span t-else="" class="ai-tree-status error">&#x2717;</span>
                                    </div>

                                </t>
                            </t>

                        </t>
                    </t>

                </t>

            </aside>

            <!-- Detail panel -->
            <main class="ai-debug-detail">
                <div t-if="!state.selectedId and traces.size === 0" class="ai-debug-detail-empty">
                    <span class="ai-debug-pulse-dot large"/>
                    <p>Listening for agentic loops...</p>
                    <p class="ai-debug-detail-hint">
                        Trigger an AI action in Odoo to see live trace data here.
                    </p>
                </div>
                <div t-elif="!state.selectedId" class="ai-debug-detail-empty">
                    <p>Select a trace, iteration, or tool call to inspect it.</p>
                </div>
                <div t-else="" class="ai-debug-detail-selected">
                    Selected: <t t-esc="state.selectedType"/> <t t-esc="state.selectedId"/>
                </div>
            </main>

        </div>
    </div>
</t>

</templates>
