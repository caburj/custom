<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_debug.App">
    <div class="ai-debug-app">
        <!-- Header bar -->
        <header class="ai-debug-header">
            <div class="ai-debug-header-title">AI Debugger</div>
            <div class="ai-debug-header-status">
                <span t-attf-class="ai-debug-status-dot {{statusColor}}"/>
                <span class="ai-debug-status-label" t-esc="statusLabel"/>
                <span t-if="state.ephemeralMode"
                      class="ai-ephemeral-indicator"
                      title="IndexedDB unavailable — traces won't persist across refreshes">
                    Ephemeral
                </span>
            </div>
        </header>

        <!-- Main content area -->
        <div class="ai-debug-main">

            <!-- Sidebar -->
            <aside class="ai-debug-sidebar" t-attf-style="width: {{state.sidebarWidth}}px; min-width: {{state.sidebarWidth}}px;">

                <!-- Traces header bar with select-all + action buttons — stays pinned -->
                <div class="ai-tree-header">
                    <div class="ai-tree-header-left">
                        <input type="checkbox"
                               class="ai-tree-select-all"
                               t-ref="selectAll"
                               t-att-checked="allChecked"
                               t-on-change.stop="toggleSelectAll"/>
                        <span>Traces</span>
                    </div>
                    <div class="ai-tree-header-actions">
                        <button class="ai-tree-action-btn"
                                t-att-disabled="state.checkedTraceIds.size === 0 or undefined"
                                t-on-click="exportSelected"
                                title="Export selected">&#x2913;</button>
                        <button class="ai-tree-action-btn"
                                t-on-click="openImportPicker"
                                title="Import traces">&#x2912;</button>
                        <button class="ai-tree-action-btn"
                                t-att-disabled="state.checkedTraceIds.size === 0 or undefined"
                                t-on-click="deleteCheckedTraces"
                                title="Delete selected">&#x1F5D1;</button>
                    </div>
                </div>

                <!-- Scrollable tree content area — t-ref here so scrollIntoView targets the right container -->
                <div class="ai-tree-content" t-ref="sidebar">

                <!-- Depth staircase line — SVG overlay, scrolls with content -->
                <svg t-if="sidebarNodes.length > 0"
                     class="ai-depth-line-svg"
                     t-att-height="depthLineTotalHeight"
                     width="50"
                     aria-hidden="true">
                    <t t-foreach="depthLinePaths" t-as="seg" t-key="seg_index">
                        <path t-att-d="seg.d"
                              t-att-stroke="seg.color"
                              stroke-width="2.5"
                              fill="none"
                              stroke-linecap="round"/>
                    </t>
                </svg>

                <!-- Empty state — only when no traces -->
                <div t-if="traces.size === 0" class="ai-debug-sidebar-empty">
                    <span class="ai-debug-pulse-dot"/>
                    <span>No traces yet</span>
                </div>

                <!-- Tree entries — flat list from sidebarNodes computed getter -->
                <t t-foreach="sidebarNodes" t-as="node" t-key="node.id">

                    <!-- Trace row (two-line format: query title + agent/model meta) -->
                    <t t-if="node.type === 'trace'">
                        <div t-attf-class="ai-tree-row ai-tree-trace-row ai-depth-{{ node.depth > 4 ? 4 : node.depth }}"
                             t-att-class="{
                                 'selected': state.selectedId === node.id,
                                 'ancestor': selectedTraceId === node.id and state.selectedId !== node.id,
                             }"
                             t-att-data-node-id="node.id">
                            <input t-if="node.depth === 0"
                                   type="checkbox"
                                   class="ai-tree-row-check"
                                   t-att-checked="state.checkedTraceIds.has(node.id)"
                                   t-on-change.stop="() => this.toggleTraceCheck(node.id)"/>
                            <span t-else="" class="ai-tree-row-check-spacer"/>
                            <span class="ai-tree-chevron"
                                  t-att-class="{'expanded': node.trace.expanded}"
                                  t-on-click.stop="() => this.toggleExpand(node.id, 'trace')">&#x203A;</span>
                            <span class="ai-tree-label"
                                  t-on-click="() => this.selectItem(node.id, 'trace')">
                                <t t-if="node.trace.user_query">
                                    <span class="ai-tree-query-title"
                                          t-att-title="node.trace.user_query"
                                          t-on-click="(ev) => this.showFullQuery(ev, node.trace.user_query)"
                                          t-esc="node.trace.user_query"/>
                                </t>
                                <t t-else="">
                                    <t t-esc="node.trace.agent_name or 'Unknown Agent'"/>
                                </t>
                                <span class="ai-tree-meta-line">
                                    <t t-esc="node.trace.agent_name or 'Agent'"/> &#xB7; <t t-esc="node.trace.model_name or ''"/>
                                </span>
                            </span>
                            <span t-if="node.trace.hydrated" class="ai-tree-hydrated-badge" title="Loaded from storage">archived</span>
                            <span t-if="node.trace.status === 'running'" class="ai-debug-pulse-dot small"/>
                            <span t-elif="node.trace.status === 'success'" class="ai-tree-status success">&#x2713;</span>
                            <span t-elif="node.trace.status === 'error'" class="ai-tree-status error">&#x2717;</span>
                            <span t-elif="node.trace.status === 'max_iterations'" class="ai-tree-status warn">&#x23F8;</span>
                        </div>
                    </t>

                    <!-- Iteration row (flat: same depth as parent trace's tool calls) -->
                    <t t-elif="node.type === 'iter'">
                        <div t-attf-class="ai-tree-row ai-tree-iter-row ai-depth-{{ node.depth > 4 ? 4 : node.depth }}"
                             t-att-class="{
                                 'selected': state.selectedId === node.id,
                                 'ancestor': selectedIterationId === node.id and state.selectedId !== node.id,
                             }"
                             t-att-data-node-id="node.id">
                            <span class="ai-tree-row-check-spacer"/>
                            <span t-if="node.iter.toolCalls.size > 0"
                                  class="ai-tree-chevron"
                                  t-att-class="{'expanded': node.iter.expanded}"
                                  t-on-click.stop="() => this.toggleExpand(node.trace.trace_id, node.id)">&#x203A;</span>
                            <span t-else="" class="ai-tree-chevron-placeholder"/>
                            <span class="ai-tree-label"
                                  t-on-click="() => this.selectItem(node.id, 'iteration')">
                                Iteration <t t-esc="node.iter.iteration_index"/>
                                <span class="ai-tree-label-dim">
                                    &#xB7; <t t-esc="node.iter.toolCalls.size"/> call<t t-if="node.iter.toolCalls.size !== 1">s</t>
                                </span>
                                <t t-set="duration" t-value="this.getIterationDuration(node.trace, node.id)"/>
                                <t t-if="duration">
                                    <span class="ai-tree-label-dim"> &#xB7; <t t-esc="duration"/></span>
                                </t>
                                <t t-elif="node.trace.status === 'running' and node.id === [...node.trace.iterations.keys()].pop()">
                                    <span class="ai-tree-label-dim"> &#xB7; <span class="ai-debug-pulse-dot tiny"/></span>
                                </t>
                                <t t-if="node.iter.has_error"><span class="ai-tree-label-error"> &#xB7; error</span></t>
                            </span>
                        </div>
                    </t>

                    <!-- Tool call row (flat: same depth as iteration rows) -->
                    <t t-elif="node.type === 'tc'">
                        <div t-attf-class="ai-tree-row ai-tree-tc-row ai-depth-{{ node.depth > 4 ? 4 : node.depth }}"
                             t-att-class="{
                                 'selected': state.selectedId === node.id,
                             }"
                             t-att-data-node-id="node.id">
                            <span class="ai-tree-row-check-spacer"/>
                            <span t-if="node.hasChildren"
                                  class="ai-tree-chevron"
                                  t-att-class="{'expanded': node.tc.expanded}"
                                  t-on-click.stop="() => this.toggleExpand(node.trace.trace_id, node.tc.iteration_id, node.id)">&#x203A;</span>
                            <span t-else="" class="ai-tree-chevron-placeholder"/>
                            <span class="ai-tree-label"
                                  t-on-click="() => this.selectItem(node.id, 'tool_call')">
                                <t t-esc="node.tc.tool_name"/>
                            </span>
                            <span t-if="node.tc.status === 'running'" class="ai-debug-pulse-dot tiny"/>
                            <span t-elif="node.tc.success" class="ai-tree-status success">&#x2714;</span>
                            <span t-elif="node.tc.success === false" class="ai-tree-status error">&#x2717;</span>
                        </div>
                    </t>

                </t>

                </div> <!-- end .ai-tree-content -->

            </aside>

            <div class="ai-debug-resize-handle"
                 t-on-pointerdown="onResizeStart"/>

            <!-- Detail panel -->
            <main class="ai-debug-detail">
                <!-- Empty state: no traces at all (SESS-03) -->
                <div t-if="traces.size === 0" class="ai-debug-detail-empty">
                    <span class="ai-debug-pulse-dot large"/>
                    <p>Listening for agentic loops...</p>
                    <p class="ai-debug-detail-hint">
                        Trigger an AI action in Odoo to see live trace data here.
                    </p>
                </div>
                <!-- Loop detail -->
                <LoopDetail t-elif="state.selectedType === 'trace'"
                            t-key="state.selectedId"
                            trace="getSelectedTrace()"/>
                <!-- Iteration detail -->
                <IterationDetail t-elif="state.selectedType === 'iteration'"
                                 t-key="state.selectedId"
                                 iteration="getSelectedIteration()"/>
                <!-- Tool call detail -->
                <ToolCallDetail t-elif="state.selectedType === 'tool_call'"
                                t-key="state.selectedId"
                                toolCall="getSelectedToolCall()"/>
                <!-- Fallback: traces exist but nothing selected (safety net; normally unreachable due to auto-select) -->
                <div t-else="" class="ai-debug-detail-empty">
                    <p>Select a trace, iteration, or tool call to inspect it.</p>
                </div>
            </main>

        </div>
        <MainComponentsContainer/>
        <input type="file"
               accept=".json"
               class="d-none"
               t-ref="fileInput"
               t-on-change="onFileSelected"/>
    </div>
</t>

</templates>
