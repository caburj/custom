<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_debug.ToolCallDetail">
    <div t-if="this.props.toolCall" class="ai-detail-view">
        <div class="ai-detail-header">
            <span class="ai-detail-type-badge">Tool Call</span>
            <span class="ai-detail-name" t-out="this.props.toolCall.tool_name"/>
            <span t-if="this.props.toolCall.success === null" class="ai-detail-meta" style="color: var(--warning);">Pending</span>
            <span t-elif="this.props.toolCall.success" class="ai-detail-meta success">Success</span>
            <span t-else="" class="ai-detail-meta error">Failed</span>
            <CopyButton content="() => this.fullToolCallJson" successText="'Copied!'" className="'ms-auto'"/>
        </div>

        <!-- Error banner if failed -->
        <div t-if="this.props.toolCall.error" class="alert alert-danger mb-0 rounded-0 border-start-0 border-end-0 py-2 px-3">
            <strong>Error:</strong> <t t-out="this.props.toolCall.error"/>
        </div>

        <Notebook>
            <t t-set-slot="arguments" title="'Arguments'" isVisible="true">
                <div class="ai-detail-section">
                    <div class="ai-detail-section-header">
                        <span>Arguments</span>
                        <CopyButton content="() => this.argsJson" successText="'Copied!'"/>
                    </div>
                    <JsonTree data="this.props.toolCall.args"
                              onExpandText="(title, content) => this.openTextPopup(title, content, 'json')"
                              onExpandImage="(title, src) => this.openImagePopup(title, src)"/>
                </div>
            </t>

            <t t-set-slot="result" title="'Result'" isVisible="true">
                <div class="ai-detail-section">
                    <div class="ai-detail-section-header">
                        <span>Result</span>
                        <CopyButton content="() => this.resultString" successText="'Copied!'"/>
                    </div>
                    <!-- If result is an object/array, use JsonTree; otherwise show as text -->
                    <t t-if="this.resultIsObject">
                        <JsonTree data="this.props.toolCall.result"
                                  onExpandText="(title, content) => this.openTextPopup(title, content, 'json')"
                                  onExpandImage="(title, src) => this.openImagePopup(title, src)"/>
                    </t>
                    <t t-else="">
                        <t t-if="this.resultIsLong">
                            <div class="ai-detail-text-preview"
                                 t-on-click="() => this.openTextPopup('Result', this.resultString, 'markdown')"
                                 t-out="this.resultString"/>
                        </t>
                        <t t-else="">
                            <pre class="ai-detail-text-block" t-out="this.resultString"/>
                        </t>
                    </t>
                </div>
            </t>

            <t t-set-slot="confirmation" title="'Confirmation Info'" isVisible="this.hasConfirmation">
                <div class="ai-detail-section">
                    <div class="ai-detail-section-header">
                        <span>Confirmation Info</span>
                        <span class="badge text-bg-warning ms-2">Confirmation Required</span>
                    </div>
                    <pre class="ai-detail-text-block ai-detail-confirmation-message" t-out="this.props.toolCall.confirmation_message"/>
                </div>
            </t>
        </Notebook>
    </div>
</t>

</templates>
