<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_debug.IterationDetail">
    <div t-if="props.iteration" class="ai-detail-view">
        <div class="ai-detail-header">
            <span class="ai-detail-type-badge">Iteration</span>
            <span class="ai-detail-name">Iteration <t t-esc="props.iteration.iteration_index"/></span>
            <span t-if="props.iteration.is_final" class="ai-detail-meta">Final</span>
            <span t-if="props.iteration.has_error" class="ai-detail-meta error">Error</span>
            <span t-if="props.iteration.duration_ms"
                  class="ai-metric-chip">
                <t t-esc="this.formatDuration(props.iteration.duration_ms)"/>
            </span>
            <span t-if="props.iteration.tokens and props.iteration.tokens.total > 0"
                  class="ai-metric-chip">
                <t t-esc="this.formatTokens(props.iteration.tokens.total)"/> tok
            </span>
        </div>

        <!-- Error banner if iteration has error -->
        <div t-if="props.iteration.error" class="alert alert-danger mb-0 rounded-0 border-start-0 border-end-0 py-2 px-3">
            <strong>Error:</strong> <t t-esc="props.iteration.error"/>
        </div>

        <Notebook>
            <t t-set-slot="messages" title="'Messages Sent'" isVisible="true">
                <div class="ai-detail-section">
                    <div class="ai-detail-section-header">
                        <span>Messages Sent (<t t-esc="(props.iteration.messages_sent || []).length"/> messages)</span>
                        <CopyButton content="() => this.messagesJson"/>
                    </div>
                    <JsonTree data="props.iteration.messages_sent"
                              onExpandText="(title, content) => this.openTextPopup(title, content, 'json')"/>
                </div>
            </t>

            <t t-set-slot="request" title="'Request'" isVisible="true">
                <div class="ai-detail-section">
                    <div class="ai-detail-section-header">
                        <span>HTTP Request Body</span>
                        <CopyButton content="() => this.requestJson"/>
                    </div>
                    <JsonTree data="props.iteration.request_body"
                              onExpandText="(title, content) => this.openTextPopup(title, content, 'json')"/>
                </div>
            </t>

            <t t-set-slot="response" title="'Raw Response'" isVisible="true">
                <div class="ai-detail-section">
                    <div class="ai-detail-section-header">
                        <span>Raw LLM Response</span>
                        <CopyButton content="() => this.responseJson"/>
                    </div>
                    <JsonTree data="props.iteration.raw_response"
                              onExpandText="(title, content) => this.openTextPopup(title, content, 'json')"/>
                </div>
            </t>

        </Notebook>
    </div>
</t>

</templates>
