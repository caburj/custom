<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_debug.LoopDetail">
    <div t-if="props.trace" class="ai-detail-view">
        <!-- Header -->
        <div class="ai-detail-header">
            <span class="ai-detail-type-badge">Loop</span>
            <span class="ai-detail-name" t-esc="props.trace.agent_name"/>
            <span class="ai-detail-meta" t-esc="props.trace.model_name"/>
            <span t-if="props.trace.status === 'running'"
                  class="ai-metric-chip ai-metric-chip--live">running</span>
            <span t-elif="props.trace.duration_ms"
                  class="ai-metric-chip">
                <t t-esc="this.formatDuration(props.trace.duration_ms)"/>
            </span>
        </div>

        <!-- Tabbed content -->
        <Notebook>
            <t t-set-slot="system_prompt" title="'System Prompt'" isVisible="true">
                <div class="ai-detail-section">
                    <div class="ai-detail-section-header">
                        <span>System Prompt</span>
                        <CopyButton content="() => this.instructionsContent"/>
                    </div>
                    <!-- Truncated text preview; click opens popup -->
                    <div class="ai-detail-text-preview"
                         t-on-click="() => this.openTextPopup('System Prompt', props.trace.instructions, 'markdown')"
                         t-esc="props.trace.instructions"/>
                </div>
            </t>

            <t t-set-slot="rag_context" title="'RAG Context'" isVisible="true">
                <div class="ai-detail-section">
                    <div class="ai-detail-section-header">
                        <span>RAG Context</span>
                    </div>
                    <div t-if="!ragContextMessages" class="ai-detail-empty-tab">
                        Waiting for first iteration to capture RAG context...
                    </div>
                    <div t-elif="ragContextMessages.length === 0" class="ai-detail-empty-tab">
                        No RAG context detected in this trace.
                    </div>
                    <t t-else="">
                        <t t-foreach="ragContextMessages" t-as="msg" t-key="msg_index">
                            <div class="ai-detail-section">
                                <div class="ai-detail-section-header">
                                    <span t-esc="'System Message ' + (msg_index + 1)"/>
                                    <CopyButton content="() => msg.content"/>
                                </div>
                                <div class="ai-detail-text-preview"
                                     t-on-click="() => this.openTextPopup('RAG Context', msg.content, 'markdown')"
                                     t-esc="msg.content"/>
                            </div>
                        </t>
                    </t>
                </div>
            </t>

            <t t-set-slot="tools" title="'Tools Definition'" isVisible="true">
                <div class="ai-detail-section">
                    <div class="ai-detail-section-header">
                        <span>Tools Definition</span>
                        <CopyButton content="() => this.toolsJson"/>
                    </div>
                    <JsonTree data="props.trace.tools" onExpandText="(title, content) => this.openTextPopup(title, content, 'json')"/>
                </div>
            </t>

            <t t-set-slot="metrics" title="'Metrics'" isVisible="true">
                <div class="ai-metrics-table-wrapper">
                    <table class="ai-metrics-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Duration</th>
                                <th>Input</th>
                                <th>Output</th>
                                <th>Cached</th>
                                <th>Reasoning</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="this.iterationRows" t-as="row" t-key="row.index">
                                <tr>
                                    <td t-esc="row.index"/>
                                    <td t-esc="row.duration_ms > 0 ? this.formatDuration(row.duration_ms) : '\u2013'"/>
                                    <td t-esc="row.tokens.input > 0 ? this.formatTokens(row.tokens.input) : '\u2013'"/>
                                    <td t-esc="row.tokens.output > 0 ? this.formatTokens(row.tokens.output) : '\u2013'"/>
                                    <td t-esc="row.tokens.cache_read > 0 ? this.formatTokens(row.tokens.cache_read) : '\u2013'"/>
                                    <td t-esc="row.tokens.reasoning > 0 ? this.formatTokens(row.tokens.reasoning) : '\u2013'"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="ai-metrics-totals-row">
                                <td><strong>Total</strong></td>
                                <td><strong t-esc="this.traceTotals.total_duration_ms > 0 ? this.formatDuration(this.traceTotals.total_duration_ms) : '\u2013'"/></td>
                                <td><strong t-esc="this.traceTotals.total_input > 0 ? this.formatTokens(this.traceTotals.total_input) : '\u2013'"/></td>
                                <td><strong t-esc="this.traceTotals.total_output > 0 ? this.formatTokens(this.traceTotals.total_output) : '\u2013'"/></td>
                                <td><strong t-esc="this.traceTotals.total_cached > 0 ? this.formatTokens(this.traceTotals.total_cached) : '\u2013'"/></td>
                                <td><strong t-esc="this.traceTotals.total_reasoning > 0 ? this.formatTokens(this.traceTotals.total_reasoning) : '\u2013'"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </Notebook>
    </div>
</t>

</templates>
