<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_debug.JsonTree">
    <div t-att-class="'ai-json-node' + (this.depth > 0 ? ' ai-json-nested' : '')">

        <!-- Expandable node (object or array) -->
        <t t-if="this.isExpandable">
            <div class="ai-json-row ai-json-row-expandable">
                <span class="ai-json-toggle" t-on-click="this.toggle">
                    <t t-if="this.state.expanded">&#x2212;</t>
                    <t t-else="">+</t>
                </span>
                <t t-if="this.props.label">
                    <span class="ai-json-key" t-out="this.props.label"/>
                </t>
                <span class="ai-json-preview ai-json-value" t-out="this.collapsedPreview"/>
                <CopyButton content="() => this.subtreeJson"
                            className="'ai-json-copy-btn'"
                            successText="'Copied!'"/>
            </div>
            <t t-if="this.state.expanded">
                <t t-foreach="this.entries" t-as="entry" t-key="entry[0]">
                    <JsonTree data="entry[1]"
                              label="entry[0]"
                              depth="this.depth + 1"
                              onExpandText="this.props.onExpandText"
                              onExpandImage="this.props.onExpandImage"
                              forceCollapsed="this.state.childForceCollapsed"
                              forceVersion="this.state.childForceVersion"/>
                </t>
            </t>
        </t>

        <!-- Leaf node (string, number, boolean, null) -->
        <t t-else="">
            <div class="ai-json-row">
                <span class="ai-json-toggle-placeholder"/>
                <t t-if="this.props.label">
                    <span class="ai-json-key" t-out="this.props.label"/>
                </t>
                <t t-if="this.isImageValue">
                    <span class="ai-json-image-leaf" t-on-click="this.onClickImage"
                          t-on-mouseenter="this.onImageMouseEnter">
                        <span class="ai-json-string ai-json-value">"[image]"</span>
                        <div class="ai-json-image-overlay" t-custom-ref="imageOverlay">
                            <img t-att-src="this.imageSrc" class="ai-json-image-thumb"/>
                        </div>
                    </span>
                </t>
                <t t-elif="this.type === 'string'">
                    <span class="ai-json-string ai-json-value ai-json-truncated" t-on-click="this.onClickLongString"
                          t-out="this.displayValue" title="Click to expand"/>
                </t>
                <t t-elif="this.type === 'number'">
                    <span class="ai-json-number ai-json-value" t-out="this.displayValue"/>
                </t>
                <t t-elif="this.type === 'boolean'">
                    <span class="ai-json-boolean ai-json-value" t-out="this.displayValue"/>
                </t>
                <t t-else="">
                    <span class="ai-json-null ai-json-value" t-out="this.displayValue"/>
                </t>
            </div>
        </t>

    </div>
</t>

</templates>
