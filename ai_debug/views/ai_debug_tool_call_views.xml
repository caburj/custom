<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_ai_debug_tool_call_form" model="ir.ui.view">
        <field name="name">ai.debug.tool.call.form</field>
        <field name="model">ai.debug.tool.call</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="iteration_id" readonly="1"/>
                            <field name="tool_name" readonly="1"/>
                            <field name="call_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="success" readonly="1"/>
                            <field name="duration_human" readonly="1"/>
                            <field name="triggered_confirmation" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Arguments" name="arguments">
                            <field name="args_pretty" widget="ace"
                                options="{'mode': 'json'}" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Result" name="result">
                            <field name="result" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Confirmation" name="confirmation"
                            invisible="not triggered_confirmation">
                            <field name="confirmation_message" readonly="1"/>
                        </page>
                        <page string="State Snapshots" name="state_snapshots">
                            <separator string="State Before"/>
                            <field name="state_before_pretty" widget="ace"
                                options="{'mode': 'json'}" readonly="1" nolabel="1"/>
                            <separator string="State After"/>
                            <field name="state_after_pretty" widget="ace"
                                options="{'mode': 'json'}" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_ai_debug_tool_call_search" model="ir.ui.view">
        <field name="name">ai.debug.tool.call.search</field>
        <field name="model">ai.debug.tool.call</field>
        <field name="arch" type="xml">
            <search string="AI Debug Tool Calls">
                <field name="tool_name"/>
                <field name="iteration_id"/>
                <separator/>
                <filter string="Confirmations" name="confirmations"
                    domain="[('triggered_confirmation', '=', True)]"/>
            </search>
        </field>
    </record>

</odoo>
