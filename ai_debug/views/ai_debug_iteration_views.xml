<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_ai_debug_iteration_form" model="ir.ui.view">
        <field name="name">ai.debug.iteration.form</field>
        <field name="model">ai.debug.iteration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="trace_id" readonly="1"/>
                            <field name="index" readonly="1"/>
                        </group>
                        <group>
                            <field name="duration_human" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages Sent" name="messages_sent">
                            <field name="messages_sent_pretty" widget="ace"
                                options="{'mode': 'json'}" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Raw Response" name="raw_response">
                            <field name="raw_response_pretty" widget="ace"
                                options="{'mode': 'json'}" readonly="1" nolabel="1"/>
                        </page>
                        <page string="State Snapshots" name="state_snapshots">
                            <separator string="State Before"/>
                            <field name="state_before_pretty" widget="ace"
                                options="{'mode': 'json'}" readonly="1" nolabel="1"/>
                            <separator string="State After"/>
                            <field name="state_after_pretty" widget="ace"
                                options="{'mode': 'json'}" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Tool Calls" name="tool_calls">
                            <field name="tool_call_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="tool_name"/>
                                    <field name="success"/>
                                    <field name="duration_human" string="Duration"/>
                                    <field name="triggered_confirmation"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_ai_debug_iteration_search" model="ir.ui.view">
        <field name="name">ai.debug.iteration.search</field>
        <field name="model">ai.debug.iteration</field>
        <field name="arch" type="xml">
            <search string="AI Debug Iterations">
                <field name="trace_id"/>
                <field name="index"/>
            </search>
        </field>
    </record>

</odoo>
